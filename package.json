{
  "name": "appeal-ai",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @appeal/shared build && pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter @appeal/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @appeal/shared build && pnpm -r test",
    "migrate": "pnpm --filter @appeal/api migrate",
    "db:generate": "pnpm --filter @appeal/api db:generate",
    "db:seed": "pnpm --filter @appeal/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "globals": "^17.14.0"
  }
}
