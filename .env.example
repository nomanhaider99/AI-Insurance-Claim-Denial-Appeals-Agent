# Copy to .env for local (non-Docker) runs. Synthetic/dev values only — never real secrets or PHI.
NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgres://appeal:appeal@localhost:5432/appeal
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=appeal-documents
S3_ACCESS_KEY=devaccesskey
S3_SECRET_KEY=devsecretkey-change-me

# Auth (Phase 2). Generate a real secret: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
APP_URL=http://localhost:3000
# false only for plain-http local dev
COOKIE_SECURE=false
TRUST_PROXY=0
MAIL_TRANSPORT=console
SEED_PASSWORD=Demo-Password-123!
# Phase 3+
ANTHROPIC_API_KEY=

# Web -> API proxy target (Next.js rewrites /api/* here)
API_INTERNAL_URL=http://localhost:4000
